# .editorconfig

# Root configuration
root = true

# Global settings for all files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Python files
[*.py]
max_line_length = 120

# TOML files
[*.toml]
indent_style = space
indent_size = 4

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Makefile
# make requires tab indentation for recipe lines
[Makefile]
indent_style = tab

# Markdown files
[*.md]
indent_style = space
indent_size = 2
max_line_length = 120

# Link list of raw source URLs; a URL is one token and cannot wrap,
# so the length rule is off here.
[.pi/prompts/python/pyproject/base-note.md]
max_line_length = off
