(* apiscope/layout.ebnf *)

(* the current concrete scopes; the rules live in AGENTS.md *)

root            = { command_scope } , { library_scope } ;

command_scope   = command_name , [ private_library ] ;
command_name    = "add" | "remove" | "list" | "sync" | "view" | "read" ;
private_library = "_lib" , { fetch_source } ;

library_scope   = library_name , { source_scope } ;
library_name    = "view_lib" | "read_lib" ;

source_scope    = source_name , role_file ;
source_name     = "filesystem" | "repo" | "openapi" | "rfc" | "llmstxt" ;
role_file       = "viewer.py" | "reader.py" | "fetcher.py" ;

fetch_source    = source_name , "fetcher.py" ;
